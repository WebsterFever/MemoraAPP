# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts is intentionally tracked (not ignored) — CI runs typecheck
# without ever running `expo start`, which is what normally (re)generates
# this file, and its content is deterministic boilerplate anyway.

