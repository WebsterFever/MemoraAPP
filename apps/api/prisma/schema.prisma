generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserStatus {
  ACTIVE
  DELETION_PENDING
  DELETED
}

enum FamilyRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum ProfileStatus {
  ACTIVE
  CLAIMED
  DEACTIVATED
  DELETION_PENDING
  DELETED
}

enum ProfileRole {
  MEMORY_OWNER
  CONTRIBUTOR
  VIEWER
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  displayName       String
  preferredLanguage String   @default("en")
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  refreshTokens     RefreshToken[]
  memberships       FamilyMembership[]
  ownedFamilies     Family[] @relation("FamilyOwner")
  createdProfiles   MemoryProfile[] @relation("ProfileCreator")
  profilePermissions MemoryProfilePermission[] @relation("PermissionUser")
  grantedPermissions MemoryProfilePermission[] @relation("PermissionGranter")
  createdMemories    Memory[] @relation("MemoryCreator")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  deviceInfo  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Family {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())
  owner       User     @relation("FamilyOwner", fields: [ownerUserId], references: [id])
  memberships FamilyMembership[]
  profiles    MemoryProfile[]
  memories    Memory[]
}

model FamilyMembership {
  id       String @id @default(uuid())
  familyId String
  userId   String
  role     FamilyRole @default(CONTRIBUTOR)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([familyId, userId])
  @@index([userId])
}

model MemoryProfile {
  id                String @id @default(uuid())
  familyId          String
  displayName       String
  relationship      String?
  preferredLanguage String @default("en")
  spokenLanguages   String[] @default([])
  biography         String?
  status            ProfileStatus @default(ACTIVE)
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  family            Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy         User @relation("ProfileCreator", fields: [createdByUserId], references: [id])
  permissions       MemoryProfilePermission[]
  memories          Memory[]
  @@index([familyId])
}

model MemoryProfilePermission {
  id              String @id @default(uuid())
  profileId       String
  userId          String
  role            ProfileRole
  grantedByUserId String
  grantedAt       DateTime @default(now())
  revokedAt       DateTime?
  profile         MemoryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user            User @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User @relation("PermissionGranter", fields: [grantedByUserId], references: [id])
  @@unique([profileId, userId])
  @@index([userId])
}

model Memory {
  id              String   @id @default(uuid())
  familyId        String
  profileId       String?
  title           String
  story           String
  occurredAt      DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  family          Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile         MemoryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdBy       User @relation("MemoryCreator", fields: [createdByUserId], references: [id])
  @@index([familyId, occurredAt])
  @@index([profileId])
}
