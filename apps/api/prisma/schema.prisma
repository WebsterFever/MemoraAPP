generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserStatus {
  ACTIVE
  DELETION_PENDING
  DELETED
}

enum FamilyRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum ProfileStatus {
  ACTIVE
  CLAIMED
  DEACTIVATED
  DELETION_PENDING
  DELETED
}

enum ProfileRole {
  MEMORY_OWNER
  CONTRIBUTOR
  VIEWER
}

enum MediaType {
  AUDIO
  // IMAGE and VIDEO are intentionally not added yet — Phase 4 is audio
  // only. The storage/authorization architecture (MediaAsset, presigned
  // URLs, StorageProvider abstraction) is designed to support them later
  // without a schema rewrite.
}

enum MediaStorageProvider {
  S3
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
}

enum MemorySourceStatus {
  PENDING
  PROCESSING
  TRANSCRIBED
  FAILED
}

enum MemoryChunkStatus {
  PENDING
  EMBEDDED
  FAILED
}

model User {
  id                 String                    @id @default(uuid())
  email              String                    @unique
  passwordHash       String
  displayName        String
  preferredLanguage  String                    @default("en")
  status             UserStatus                @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  refreshTokens      RefreshToken[]
  memberships        FamilyMembership[]
  ownedFamilies      Family[]                  @relation("FamilyOwner")
  createdProfiles    MemoryProfile[]           @relation("ProfileCreator")
  profilePermissions MemoryProfilePermission[] @relation("PermissionUser")
  grantedPermissions MemoryProfilePermission[] @relation("PermissionGranter")
  createdMemories    Memory[]                  @relation("MemoryCreator")
  uploadedMedia      MediaAsset[]              @relation("MediaUploader")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Family {
  id           String             @id @default(uuid())
  name         String
  ownerUserId  String
  createdAt    DateTime           @default(now())
  owner        User               @relation("FamilyOwner", fields: [ownerUserId], references: [id])
  memberships  FamilyMembership[]
  profiles     MemoryProfile[]
  memories     Memory[]
  mediaAssets  MediaAsset[]
  memoryChunks MemoryChunk[]
}

model FamilyMembership {
  id       String           @id @default(uuid())
  familyId String
  userId   String
  role     FamilyRole       @default(CONTRIBUTOR)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  family   Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model MemoryProfile {
  id                String                    @id @default(uuid())
  familyId          String
  displayName       String
  relationship      String?
  preferredLanguage String                    @default("en")
  spokenLanguages   String[]                  @default([])
  biography         String?
  status            ProfileStatus             @default(ACTIVE)
  createdByUserId   String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  family            Family                    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy         User                      @relation("ProfileCreator", fields: [createdByUserId], references: [id])
  permissions       MemoryProfilePermission[]
  memories          Memory[]
  memoryChunks      MemoryChunk[]

  @@index([familyId])
}

model MemoryProfilePermission {
  id              String        @id @default(uuid())
  profileId       String
  userId          String
  role            ProfileRole
  grantedByUserId String
  grantedAt       DateTime      @default(now())
  revokedAt       DateTime?
  profile         MemoryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user            User          @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User          @relation("PermissionGranter", fields: [grantedByUserId], references: [id])

  @@unique([profileId, userId])
  @@index([userId])
}

model Memory {
  id              String         @id @default(uuid())
  familyId        String
  profileId       String?
  title           String
  story           String
  occurredAt      DateTime?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  family          Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile         MemoryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("MemoryCreator", fields: [createdByUserId], references: [id])
  mediaAssets     MediaAsset[]
  sources         MemorySource[]
  chunks          MemoryChunk[]

  @@index([familyId, occurredAt])
  @@index([profileId])
}

/// A single stored media file (audio in Phase 4; photo/video in later
/// phases) attached to a Memory. The object itself lives in S3 (or another
/// StorageProvider implementation later) — this row is only metadata plus
/// the server-generated storage key. `status` tracks the presigned-upload
/// lifecycle: PENDING until the client's S3 PUT completes and the backend
/// independently verifies the object (see MediaService.completeUpload),
/// READY once verified, FAILED if verification fails (object is deleted).
model MediaAsset {
  id               String               @id @default(uuid())
  familyId         String
  memoryId         String
  uploadedByUserId String
  type             MediaType
  storageProvider  MediaStorageProvider @default(S3)
  storageKey       String               @unique
  mimeType         String
  sizeBytes        Int?
  durationMs       Int?
  status           MediaAssetStatus     @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  family           Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memory           Memory               @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  uploadedBy       User                 @relation("MediaUploader", fields: [uploadedByUserId], references: [id])
  source           MemorySource?

  @@index([memoryId])
  @@index([familyId])
}

/// Phase 5: transcription output for an audio MediaAsset. One row per
/// MediaAsset. The original audio in S3 (MediaAsset) is never modified by
/// this or any later pipeline stage — transcripts are additive, linked data.
/// `rawTranscript` is the verbatim STT output; `cleanedTranscript` is a
/// separate, non-destructive cleanup pass (doc 06 stage 4) — raw is kept
/// forever alongside it, never overwritten.
model MemorySource {
  id                String             @id @default(uuid())
  mediaAssetId      String             @unique
  memoryId          String
  status            MemorySourceStatus @default(PENDING)
  detectedLanguage  String?
  rawTranscript     String?
  cleanedTranscript String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mediaAsset        MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  memory            Memory             @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  chunks            MemoryChunk[]

  @@index([memoryId])
}

/// Phase 6: a semantically retrievable slice of a MemorySource's cleaned
/// transcript. familyId/profileId are denormalized directly onto the chunk
/// (not just reachable via memory/memorySource joins) so the authorization
/// filter — family membership + profile permission — can be applied as a
/// SQL predicate directly in the vector similarity query's WHERE clause
/// (doc 02 §5, doc 04 §3 step 3), never as a post-filter on already-fetched
/// rows. `status` mirrors the MediaAsset/MemorySource PENDING-lifecycle
/// pattern: a chunk's text is written first (PENDING), then embedded
/// (EMBEDDED) or marked FAILED by a later, separate pipeline stage — chunk
/// rows are never re-derived or overwritten once EMBEDDED, matching the
/// "never destroy the original source" rule extended to derived data.
///
/// `embedding` has no native Prisma scalar for pgvector's `vector` type, so
/// it is declared Unsupported — Prisma's migration engine still emits the
/// correct `vector(1536)` column from this declaration, but the column can
/// only be written/read via $executeRaw/$queryRaw, never through the
/// generated Prisma Client CRUD methods (create/update/findMany, etc.).
/// 1536 dimensions matches OpenAI text-embedding-3-small (or
/// text-embedding-3-large truncated via the `dimensions` param) — flagged
/// for explicit confirmation before the embedding call is implemented,
/// since changing it later requires re-embedding every existing chunk.
model MemoryChunk {
  id             String            @id @default(uuid())
  memorySourceId String
  memoryId       String
  familyId       String
  profileId      String?
  chunkIndex     Int
  text           String
  status         MemoryChunkStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  embedding Unsupported("vector(1536)")?

  memorySource MemorySource   @relation(fields: [memorySourceId], references: [id], onDelete: Cascade)
  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  family       Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile      MemoryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([memorySourceId, chunkIndex])
  @@index([familyId, profileId])
  @@index([memoryId])
}
