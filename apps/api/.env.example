# Copy to .env and adjust as needed. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Matches the postgres service in the repo-root docker-compose.yml.
# Host port is 5433 (not Postgres's default 5432) to avoid colliding with a
# native/non-Docker PostgreSQL install some machines already have on 5432.
DATABASE_URL=postgresql://memora:memora@localhost:5433/memora_dev

# Matches the redis service in the repo-root docker-compose.yml
REDIS_URL=redis://localhost:6379

# Required — JWT signing secrets (min 32 chars). Generate your own for real
# use; these are fine for local dev only.
JWT_ACCESS_SECRET=dev-access-secret-change-before-production-please-0000
JWT_REFRESH_SECRET=dev-refresh-secret-change-before-production-please-000

# --- Phase 4: MediaModule / audio upload ---
# Optional at boot — the API runs fine without these; only media
# upload/playback endpoints return 503 until all four are set. Never commit
# real values. See docs/architecture/06-audio-pipeline-jobs-storage.md.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Added in later phases (documented here now so the shape is known) ---
# OPENAI_API_KEY=               # Phase 5+ (transcription/embeddings/LLM) — backend only, never in mobile
# LANGFUSE_PUBLIC_KEY=          # Phase 10 (ObservabilityModule)
# LANGFUSE_SECRET_KEY=          # Phase 10 (ObservabilityModule)
